<?xml version="1.0"?>
<robot name="so101">
  <group name="arm">
    <chain base_link="base_link" tip_link="gripper_link"/>
  </group>

  <group name="gripper">
    <joint name="gripper"/>
  </group>

  <group name="so101">
    <group name="arm"/>
    <group name="gripper"/>
  </group>

  <group_state name="zero" group="arm">
    <joint name="shoulder_pan" value="0"/>
    <joint name="shoulder_lift" value="0"/>
    <joint name="elbow_flex" value="0"/>
    <joint name="wrist_flex" value="0"/>
    <joint name="wrist_roll" value="0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="shoulder_pan" value="0"/>
    <joint name="shoulder_lift" value="-0.55"/>
    <joint name="elbow_flex" value="0.80"/>
    <joint name="wrist_flex" value="-0.25"/>
    <joint name="wrist_roll" value="0"/>
  </group_state>

  <group_state name="zero" group="gripper">
    <joint name="gripper" value="0"/>
  </group_state>

  <group_state name="zero" group="so101">
    <joint name="shoulder_pan" value="0"/>
    <joint name="shoulder_lift" value="0"/>
    <joint name="elbow_flex" value="0"/>
    <joint name="wrist_flex" value="0"/>
    <joint name="wrist_roll" value="0"/>
    <joint name="gripper" value="0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="gripper" value="1.0"/>
  </group_state>

  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="dummy_link"/>
  <end_effector name="gripper_eef" parent_link="gripper_link" group="gripper" parent_group="arm"/>

  <disable_collisions link1="dummy_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="lower_arm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_frame_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="moving_jaw_so101_v1_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_frame_link" link2="moving_jaw_so101_v1_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="lower_arm_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="wrist_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="gripper_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="gripper_frame_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="moving_jaw_so101_v1_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="lower_arm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_frame_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="moving_jaw_so101_v1_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_frame_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="moving_jaw_so101_v1_link" reason="Never"/>
  <disable_collisions link1="lower_arm_link" link2="gripper_link" reason="Never"/>
  <disable_collisions link1="lower_arm_link" link2="gripper_frame_link" reason="Never"/>
  <disable_collisions link1="lower_arm_link" link2="moving_jaw_so101_v1_link" reason="Never"/>
  <disable_collisions link1="wrist_link" link2="gripper_frame_link" reason="Never"/>
  <disable_collisions link1="wrist_link" link2="moving_jaw_so101_v1_link" reason="Never"/>
</robot>
